{
  "name": "@retrograde-labs/lune-mcp-server",
  "version": "2.1.0",
  "mcpName": "com.luneresearch/lune",
  "description": "Lune Research MCP server (stdio + Streamable HTTP) proxying api.luneresearch.com",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lune-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://luneresearch.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetrogradeLabs/lune-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/RetrogradeLabs/lune-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lune",
    "research",
    "academic-papers"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "bun src/cli.ts",
    "dev:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "ky": "catalog:",
    "redis": "^6.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
