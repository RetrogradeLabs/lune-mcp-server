{
  "name": "@retrograde-labs/lune-mcp-server",
  "version": "3.0.0",
  "mcpName": "com.luneresearch/lune",
  "description": "Lune Research MCP server, stdio and Streamable HTTP",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lune-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://luneresearch.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetrogradeLabs/lune-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/RetrogradeLabs/lune-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lune",
    "research",
    "academic-papers"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "bun src/cli.ts",
    "dev:watch": "tsup --watch",
